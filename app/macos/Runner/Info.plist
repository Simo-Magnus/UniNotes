<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Collegamenti uninotes:// (AppLinks in MainFlutterWindow.swift): tocchi
	     sui widget e ritorno da Comandi dopo il comando «UniNotes Focus». -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.simomagnus.universitynotes</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>uninotes</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>UniNotes scrive le date di esami, prove in itinere, esoneri e sessioni d'esame nel calendario «UniNotes» e le aggiorna quando le modifichi. Solo se lo attivi in Impostazioni, Calendario.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>UniNotes scrive le date di esami, prove in itinere, esoneri e sessioni d'esame nel calendario «UniNotes» e le aggiorna quando le modifichi. Solo se lo attivi in Impostazioni, Calendario.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Il riconoscimento vocale trascrive le lezioni mentre le registri. Quando possibile avviene sul Mac.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Il microfono serve a registrare le lezioni. Le registrazioni restano sul Mac finché non scegli di trascriverle o sincronizzarle.</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
