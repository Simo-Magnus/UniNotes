<?xml version="1.0" encoding="utf-8"?>
<!-- Pulsante tondo arancione (registra, pausa/riprendi): la sfumatura del
     pulsante primario dell'app, più scuro al tocco. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/widget_record_pressed" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:centerColor="@color/widget_record_mid"
                android:endColor="@color/widget_record_bottom"
                android:startColor="@color/widget_record_top" />
        </shape>
    </item>
</selector>
