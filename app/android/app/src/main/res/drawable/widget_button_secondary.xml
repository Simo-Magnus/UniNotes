<?xml version="1.0" encoding="utf-8"?>
<!-- Comando secondario («Salva»): vetro chiaro con bordo sottile, raggio 14
     (docs/SPEC_DESIGN_3.md §7.3), più pieno al tocco. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_secondary_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_secondary_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/widget_secondary_bottom"
                android:startColor="@color/widget_secondary_top" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_secondary_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
