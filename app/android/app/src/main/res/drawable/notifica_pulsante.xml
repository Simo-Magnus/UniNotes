<?xml version="1.0" encoding="utf-8"?>
<!-- Pulsanti «Pausa»/«Riprendi» e «Salva» della notifica della
     registrazione (layout/notifica_registrazione.xml): pillola azzurra
     tenue, più scura al tocco. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/notifica_pulsante_premuto" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/notifica_pulsante_fondo" />
        </shape>
    </item>
</selector>
