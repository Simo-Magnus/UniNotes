<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Registra lezione» (1×1): apre l'app nel registratore. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_record_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_record_button">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_registra_nome"
            android:src="@drawable/ic_widget_mic" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/widget_registra_testo"
        android:textColor="@color/widget_text"
        android:textSize="11sp" />
</LinearLayout>
