<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Registra lezione» basso (una riga) durante la registrazione:
     pallino, tempo e i comandi a icona (Salva ed Elimina solo se c'è posto).
     Riempito da RecordWidget.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/rec_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_rec_dot" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1">

        <Chronometer
            android:id="@+id/rec_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/rec_time_fixed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/rec_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:text="@string/widget_registra_conferma_breve"
            android:textColor="@color/widget_urgent"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/rec_pause"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_button_pause">

        <ImageView
            android:id="@+id/rec_pause_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_pause" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/rec_save"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_button_secondary"
        android:contentDescription="@string/widget_registra_salva_descrizione">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_check" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/rec_delete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_button_delete">

        <ImageView
            android:id="@+id/rec_delete_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_delete" />
    </FrameLayout>
</LinearLayout>
