to_il":"2026-10-17","id":"univpm-lm-snt1-scienze-infermieristiche-e-ostetriche-profilo-infermieristic-ade03a08","stato_libri":"da_aggiungere","stato_esami":"da_aggiungere"},{"codice":"W004944","nome":"Strategie efficaci di lavoro e comunicazione in equipe multidisciplinare","anno":null,"periodo":"2","periodo_inizio":"01/03/2027","periodo_fine":"19/06/2027","cfu":1,"ssd":null,"obbligatorio":false,"curriculum":null,"docenti":[],"url":"https://univpm.coursecatalogue.cineca.it/insegnamenti/2026/72242_104071_224141/2026/72242?coorte=2024","libri":[],"esami":[],"fonte":"https://univpm.coursecatalogue.cineca.it","verificato_il":"2026-10-17","id":"univpm-lm-snt1-scienze-infermieristiche-e-ostetriche-profilo-infermieristic-w004944","stato_libri":"da_aggiungere","stato_esami":"da_aggiungere"},{"codice":"W004738","nome":"Tirocinio - Primo Anno","anno":null,"periodo":"2","periodo_inizio":"01/03/2027","periodo_fine":"19/06/2027","cfu":10,"ssd":null,"obbligatorio":false,"curriculum":null,"docenti":["Baglioni Isabella"],"url":"https://univpm.coursecatalogue.cineca.it/insegnamenti/2026/72242_103765_223931/2026/72242?coorte=2024","libri":[],"esami":[],"fonte":"https://univpm.coursecatalogue.cineca.it","verificato_il":"2026-10-17","id":"univpm-lm-snt1-scienze-infermieristiche-e-ostetriche-profilo-infermieristic-w004738","stato_libri":"da_aggiungere","stato_esami":"da_aggiungere"}],"ammissione":{"accesso":"programmato","requisiti":"L'ammissione al corso di laurea magistrale in scienze infermieristiche è riservata coloro che hanno conseguito la laurea triennale abilitante (o titoli abilitanti equipollenti) in una delle seguenti professioni sanitarie:\n- infermiere, secondo quanto previsto dal D.M. del Ministero della sanità 14 settembre 1994, n. 739 e successive modificazioni ed integrazioni;\n- infermiere pediatrico, secondo quanto previsto dal D.M. del Ministero della sanità 17 gennaio 1997, n. 70 e successive modificazioni ed integrazioni.\nVerranno stabilite nel regolamento didattico le modalità di verifica della preparazione iniziale.\nL'accesso è a numero programmato, secondo quanto previsto dai Decreti Ministeriali di indizione delle procedure.\nIl CdLM in Scienze Infermieristiche e Ostetriche è ad accesso programmato. L'ammissione al CdS avviene attraverso una prova concorsuale, la data, le modalità di svolgimento di tale prova ed il numero degli iscrivibili sono definiti annualmente dal Ministero e pubblicati ogni anno in apposito bando di ammissione emanato dall'Ateneo. Per poter sostenere la prova è necessario seguire la relativa procedura di iscrizione e rispettare i termini di scadenza espressi nel Bando di concorso per l'ammissione ai corsi di laurea magistrale delle professioni sanitarie.\nSono ammessi alla prova di ammissione coloro che sono in possesso dei titoli di Diploma di laurea abilitante delle professioni sanitarie ricomprese nella classe (Infermiere, Infermiere Pediatrico).","test":[],"ofa":null,"livello_inglese":null,"fonte":"https://univpm.coursecatalogue.cineca.it/corsi/2026/8210","verificato_il":"2026-10-10"},"url_catalogo":"https://univpm.coursecatalogue.cineca.it/corsi/2026/8210"}],"moduli":{}}
