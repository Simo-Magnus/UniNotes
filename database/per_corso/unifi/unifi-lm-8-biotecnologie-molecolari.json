2026","periodo_fine":"20/12/2026","cfu":6,"ssd":"CHIM/02","obbligatorio":true,"curriculum":null,"docenti":["Procacci Piero"],"url":"https://unifi.coursecatalogue.cineca.it/insegnamenti/2026/52367_B352-25-25_46695_767733/2025/52367?coorte=2025","libri":[],"esami":[{"tipo":"appello","data":"2026-11-02","ora":"08:30","luogo":null,"modalita":"orale","iscrizioni_dal":"2026-10-19","iscrizioni_al":"2026-10-29","docenti":"PROCACCI PIERO CHELLI RICCARDO","note":null,"fonte":"https://unifi.esse3.cineca.it/Guide/PaginaListaAppelli.do"}],"fonte":"https://unifi.coursecatalogue.cineca.it","verificato_il":"2026-10-13","stato_libri":"da_aggiungere","modalita_esame":"orale","id":"unifi-lm-8-biotecnologie-molecolari-b019097","stato_esami":"completo"}],"ammissione":{"accesso":"libero","requisiti":"Per essere ammessi al Corso di Laurea Magistrale in Biotecnologie Molecolari occorre essere in possesso di una laurea di primo livello nella classe delle lauree in Biotecnologie (L-2 ex dm 270/04 o 1 ex dm 509/99) o di altro titolo di studio conseguito all'estero e riconosciuto idoneo, previa verifica da parte della Struttura didattica di adeguati requisiti curriculari. Tali requisiti non potranno prescindere da una solida base culturale nei settori delle discipline fondamentali dei settori chimici e biologici. Possono essere ammessi alla Laurea Magistrale anche laureati di altre classi di laurea previa verifica da parte della Struttura didattica di adeguati requisiti curriculari. In particolare si indicano i seguenti requisiti minimi per l'accesso alla Laurea Magistrale in Biotecnologie Molecolari:\n- 6 CFU in discipline matematiche: tutti i settori MAT/XX - MATH-XX ; MED/01 - MEDS-24/A; SECS-S/01 - STAT-01/A; SECS-S/02 - STAT/01/B.\n- 6 CFU in discipline fisiche: tutti i settori FIS/XX - PHYS-XX\n- 12 CFU in discipline chimiche: tutti i settori CHIM/XX - CHEM-XX ; AGR/13 - AGRI-06/B\n- 36 CFU in discipline biologiche: tutti i settori BIO/XX - BIOS-XX\nIl riconoscimento della sussistenza dei requisiti minimi richiesti viene effettuato dalla Commissione Didattica, che esamina la carriera personale presentata all'atto della domanda di iscrizione. La Commissione valuterà anche l'adeguata preparazione di tutti coloro i quali abbiano i requisiti di titolo di accesso e curriculari di cui sopra mediante colloquio.\nE’ inoltre richiesta la certificazione per Inglese livello B2, comprensione scritta, come requisito di accesso.","test":[],"ofa":null,"livello_inglese":"B2","fonte":"https://unifi.coursecatalogue.cineca.it/corsi/2026/4482","verificato_il":"2026-10-13"},"codice_ateneo":"B352","url_catalogo":"https://unifi.coursecatalogue.cineca.it/corsi/2026/4482"}],"moduli":{"unifi-lm-8-biotecnologie-molecolari-b007166":{"origine":"programma","fonte":"Programma ufficiale dell'insegnamento (https://unifi.coursecatalogue.cineca.it/insegnamenti/2025/52367_B352-25-25_25706_767719/2025/52367?coorte=2025)","moduli":[{"nome":"La risposta immunitaria naturale e acquisita","argomenti":[]},{"nome":"Immunoglobuline e ingegnerizzazione di anticorpi","argomenti":[]},{"nome":"Cellule dell'immunità naturale e acquisita","argomenti":[]},{"nome":"Attivazione linfocitaria","argomenti":[]},{"nome":"Ipersensibilità, autoimmunità e immunodeficienze","argomenti":[]}]},"unifi-lm-8-biotecnologie-molecolari-b015921":{"origine":"programma","fonte":"Programma ufficiale dell'insegnamento (https://unifi.coursecatalogue.cineca.it/insegnamenti/2025/52367_B352-25-25_39587_767722/2025/52367?coorte=2025)","moduli":[{"nome":"Marcatura isotopica delle proteine","argomenti":[]},{"nome":"Cell-free","argomenti":[]},{"nome":"Tecniche di caratterizzazione strutturale di interazioni proteiche","argomenti":[]},{"nome":"Spettri UV-vis, dicroismo circolare e NMR","argomenti":[]},{"nome":"Programmi computazionali per modelli strutturali di complessi proteici","argomenti":[]}]},"unifi-lm-8-biotecnologie-molecolari-b015924":{"origine":"programma","fonte":"Programma ufficiale dell'insegnamento (https://unifi.cou